# Copy this file to .env and fill in your own values.

# Local development
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-me

# PostgreSQL (used when DATABASE_URL is not set)
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# On Render, DATABASE_URL is set automatically from the attached database.
# DATABASE_URL=postgres://user:password@host:5432/dbname

ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SITE_DOMAIN=localhost
SITE_NAME=Django Shop

# Stripe (test keys by default)
STRIPE_PUBLIC_KEY=your-stripe-public-key
STRIPE_SECRET_KEY=your-stripe-secret-key

# Admin superuser (created automatically by `ensure_superuser` on deploy)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=you@example.com
